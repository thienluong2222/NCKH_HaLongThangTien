# ==========================================
# ICHeritage - Docker Environment Variables
# ==========================================
# Copy this file to .env and configure

# ==========================================
# PORTS
# ==========================================
FRONTEND_PORT=80
BACKEND_PORT=5001

# ==========================================
# BACKEND CONFIGURATION
# ==========================================
FLASK_DEBUG=False

# REQUIRED: Get your API key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# OPTIONAL: Override defaults
# ==========================================
# MODEL_PATH=weight/best.pt
# CSV_PATH=uploads/artifacts/merged_data.csv
