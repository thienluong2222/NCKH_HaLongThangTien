# ==========================================
# ICHeritage Backend Environment Variables
# ==========================================
# Copy this file to .env and fill in the values

# Flask Configuration
FLASK_DEBUG=False
PORT=5001
HOST=0.0.0.0

# File Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=524288000

# Model Paths
MODEL_PATH=weight/best_openvino_model/
CSV_PATH=uploads/artifacts/merged_data.csv

# API Keys (REQUIRED)
# Get your Gemini API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Bayesian Configuration (Optional - defaults will be used if not set)
# BAYESIAN_T_HIGH=0.85
# BAYESIAN_T_LOW=0.50
# BAYESIAN_DELTA=0.25
# BAYESIAN_T_OUT=0.85
